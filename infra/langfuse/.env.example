# Langfuse autoalojado (infra/langfuse/docker-compose.yml). NO edites este archivo para
# arrancar: `just langfuse-init` copia esta plantilla a infra/langfuse/.env (fuera de
# git) y rellena cada valor vacío con un secreto aleatorio. Un .env existente nunca se
# sobrescribe.

# -- secretos del servidor (generados) ---------------------------------------------------
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# -- arranque sin interfaz: el primer usuario y las claves del proyecto «Qualify» ---------
# Inicia sesión en http://localhost:3100 con este correo y la contraseña generada.
# El correo no recibe nada (no hay SMTP): solo sirve para entrar.
LANGFUSE_INIT_USER_EMAIL=admin@qualify.local
LANGFUSE_INIT_USER_NAME=Qualify
LANGFUSE_INIT_USER_PASSWORD=

# La app usa estas dos como LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY (raíz .env.example).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
