# Qualify's internal router: one origin for everything, plain HTTP on :80.
#
# TLS is NOT here. Since 2026-10-14 the VPS edge proxy (deploy/edge/, /opt/edge) is the only
# process on 80/443: it terminates TLS for every product on the box and forwards Qualify's host
# to this container over the Docker network `qualify-edge` (alias `qualify-web`). So this
# container publishes no port in production, deploying Qualify never touches the other
# products' entry, and nothing here knows about them. For a standalone run (CI smoke, local
# smoke) publish :80 and use plain HTTP — the site address `:80` accepts any Host.
#
# Routing table (first match wins inside `handle` blocks; every path not listed falls
# through to the static frontend):
#
#   /api/*            -> api:8000     FastAPI (qualify_api.http.app:create_app); includes the
#                                     Meta OAuth callback /api/connections/callback
#   /public/media/*   -> api:8000     unauthenticated media route Meta's fetcher calls (QUA-68)
#   /_event*          -> reflex:8000  Reflex websocket (state sync)
#   /_upload*         -> reflex:8000  Reflex uploads (POST) and uploaded files (GET)
#                                     request bodies capped at 520 MB (m-24957794, ADR 47:
#                                     the app refuses a file over 500 MB in Spanish; the
#                                     margin is multipart overhead); a bare 413 beyond that
#   /ping, /_health, /_all_routes
#                     -> reflex:8000  Reflex health/ping/introspection
#   /avatar/*         -> reflex:8000  api_transformer: creator avatar proxy (Qualify/avatar_proxy.py)
#   /r2media/*        -> reflex:8000  api_transformer: R2 media for drafts (Qualify/r2_media.py)
#   /r2seasonal/*     -> reflex:8000  api_transformer: seasonal stickers/videos previews
#                                     (Qualify/seasonal_media.py, m-24986798)
#   /piece-download/* -> reflex:8000  api_transformer: «Descargar» a piece as .zip
#                                     (Qualify/piece_download.py, m-24986798)
#   Every route the backend app mounts (Qualify/avatar_proxy.py `avatar_api`) MUST be
#   listed here: an unlisted one falls to the static 404 (Qualify/test_caddy_backend_routes.py).
#   everything else   -> /srv         static Reflex export (SPA fallback to 404.html)
{
	# Admin API is not needed (config is reloaded by restarting the container).
	admin off
	# Plain HTTP only: certificates live on the edge proxy.
	auto_https off
	servers {
		# The edge proxy (and, in a standalone run, nothing) sits on a private Docker network:
		# trust its X-Forwarded-For/-Proto so logs and upstreams see the real client.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	@fastapi path /api/* /public/media/*
	handle @fastapi {
		reverse_proxy api:8000
	}

	@reflex_backend path /_event /_event/* /_upload /_upload/* /ping /_health /_all_routes /avatar/* /r2media/* /r2seasonal/* /piece-download/*
	@upload path /_upload /_upload/*
	handle @reflex_backend {
		# m-24957794: the edge proxy sets no body limit, so this is the only one.
		request_body @upload {
			max_size 520MB
		}
		reverse_proxy reflex:8000
	}

	# Crawlers must be able to read the app pages' noindex directives. Do not send
	# robots.txt through the SPA error-page fallback or block all crawling here.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		respond <<ROBOTS
		User-agent: *
		Allow: /
		ROBOTS
	}

	# Reserved /assets/ and root-level files are not client-side routes. Deep route
	# identifiers may contain dots, so /drafts/id.js must still reach the SPA.
	# A stale/missing chunk or image
	# must return 404 rather than a successful HTML fallback (and must not be cached
	# for a year). Backend/media routes above retain their own response policies.
	@static_resource path_regexp static_resource ^/(assets/.*|[^/]+\.(css|js|mjs|map|ico|svg|png|jpg|jpeg|gif|webp|avif|woff|woff2|ttf|otf))$
	handle @static_resource {
		root * /srv
		# Vite's content-fingerprinted export is under /assets/. Fixed-name scripts
		# such as /glass-nav.js and assets without a fingerprint must revalidate.
		@fingerprinted {
			path_regexp fingerprinted ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(css|js|mjs|ico|svg|png|jpg|jpeg|gif|webp|avif|woff|woff2|ttf|otf)$
			file {
				root /srv
				try_files {path}
			}
		}
		route {
			header Cache-Control "no-cache"
			header @fingerprinted Cache-Control "public, max-age=31536000, immutable" {
				match status 2xx 304
			}
			file_server {
				precompressed br gzip
			}
		}
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		# Reflex exports one HTML file per static route (`/login` -> login.html or
		# login/index.html); dynamic routes (`/drafts/[draft_id]`) are resolved client-side
		# from the SPA fallback page.
		try_files {path} {path}.html {path}/index.html /404.html
		# The export ships gzip; the build also adds smaller Brotli sidecars for CSS.
		file_server {
			precompressed br gzip
		}
	}

	# HSTS is set by the edge proxy, which is where HTTPS lives.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
