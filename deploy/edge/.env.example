# /opt/edge/.env — configuration of the VPS edge proxy (deploy/edge/). Not a secret file:
# hostnames and the ACME contact only. install.sh copies this template on first run.
QUALIFY_DOMAIN=qualify.attitudefactory.co
PEDIDOS_DOMAIN=pedidos.attitudefactory.co
EDGE_ACME_EMAIL=
# Hosts extra de Qualify (separados por espacio), mismo destino; vacío = ninguno.
# Ej.: app.qualify.la (callback del plugin de Meegle, docs/plan-altas-meegle.md).
QUALIFY_EXTRA_HOSTS=
