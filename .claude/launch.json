{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qualify-crm",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "reflex",
        "run",
        "--frontend-port",
        "3100",
        "--backend-port",
        "8100"
      ],
      "env": {
        "PYTHONPATH": "packages/api/src:packages/shared/src:packages/scraper/src:packages/models/src"
      },
      "port": 3100,
      "autoPort": false
    }
  ]
}
