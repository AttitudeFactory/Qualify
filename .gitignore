.venv
__pycache__/
.web
.states
# FakeAuthProvider's persisted dev-mode identity map (QUALIFY_AUTH_FAKE=1) — plaintext
# passwords, never real credentials, never committed. See auth/fake.py.
.states/fake_auth_users.json
*.db
assets/external/
*.py[cod]
.ruff_cache/
packages/models/tests/fixtures/sample_source.mp4
.claude/settings.local.json
reflex.log

# Secrets — never commit. Holds QUALIFY_META_APP_SECRET and friends.
.env
.env.*
!.env.example
# The production template (no values) is versioned; the real file lives only on the server.
!deploy/.env.prod.example

# MkDocs build output — generated from docs/, never source.
site/

# Scratch output of the Brand Kit "Ya tengo redes" flow (Qualify/scrapecreators_client.
# py): overwritten on every profile read, holds whatever real handle a developer last
# tested with — not a source-controlled fixture like fixtures/midu.dev_prueba.json.
Qualify/fixtures/brand_connect_profile.json

# Reflex's local upload dir (rx.get_upload_dir()) — whatever a developer staged
# through the Brand Kit wizard's logo step, tenant-namespaced runtime data, not
# source.
uploaded_files/
Qualify/fixtures/discovery_*.json
Qualify/fixtures/discovery_raw/

# Coverage / audit output of `just ci-test` and `just audit` (also produced in CI).
.coverage
coverage.xml
coverage.json
coverage-summary.md
requirements.txt

# Playwright suite (tests/e2e): the harness server log
.e2e-reflex.log
