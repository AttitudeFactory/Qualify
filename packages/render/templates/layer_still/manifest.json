    "info_kinds": {
      "location": {"label": "Dónde estamos", "icon": "map-pin"},
      "hours":    {"label": "Horario", "icon": "clock"},
      "payment":  {"label": "Formas de pago", "icon": "wallet"},
      "products": {"label": "Lo más pedido", "icon": "utensils", "icon_not_food": "shopping-bag"},
      "contact":  {"label": "Pedidos", "icon": "message-circle"}
