        "slots": {
          "title":       {"4:5": [60, 3], "1:1": [48, 3], "9:16": [60, 4]},
          "subtitle":    {"4:5": [110, 3], "1:1": [80, 2], "9:16": [110, 3]},
          "call_phrase": {"4:5": [28, 1], "1:1": [28, 1], "9:16": [28, 1]}
        }
      },
      "highlight_circle": {
        "formats": ["9:16"],
        "anchors": [], "container_color": true, "default_container": "accent", "accent_word": false, "price": false,
        "circle": {"cx": 540, "cy": 960, "d": 600}, "icon_size": 320, "word_max": 9,
