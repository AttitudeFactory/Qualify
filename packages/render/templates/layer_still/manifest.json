        "height": {"4:5": [0.32, 0.40], "1:1": [0.34, 0.42], "9:16": [0.40, 0.40]},
        "story_band_top": 1150,
        "padding": 48,
        "slots": {
          "title":       {"4:5": [36, 2], "1:1": [30, 2], "9:16": [36, 2]},
          "subtitle":    {"4:5": [70, 2], "1:1": [50, 1], "9:16": [70, 2]},
          "call_phrase": {"4:5": [28, 1], "1:1": [28, 1], "9:16": [28, 1]}
        }
      },
      "info_card": {
        "formats": ["4:5", "1:1", "9:16"],
        "anchors": [], "container_color": true, "default_container": "surface", "accent_word": true, "price": false,
        "photo_strip": {"4:5": 0.32, "1:1": 0.25, "9:16": 0.25},
        "blocks": {"4:5": [1, 4, 3], "1:1": [1, 3, 2], "9:16": [1, 4, 4]},
        "kinds": ["location", "hours", "payment", "products", "contact"],
        "value": {"4:5": [60, 2], "1:1": [44, 2], "9:16": [60, 3]},
        "slots": {
          "title":       {"4:5": [30, 2], "1:1": [24, 1], "9:16": [30, 2]},
          "subtitle":    {"9:16": [50, 1]},
          "call_phrase": {"9:16": [28, 1]}
