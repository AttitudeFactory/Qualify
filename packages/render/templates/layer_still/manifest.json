{
  "id": "layer_still",
  "version": 1,
  "name": "Imagen con capa de texto",
  "niche": [],
  "serves_angles": ["layer_compose"],
  "inputs": {
    "layer":      {"type": "layer_spec"},
    "photos":     {"type": "image[]", "min": 0, "max": 1, "optional": true},
    "price_text": {"type": "string", "max": 24, "optional": true},
    "is_food":    {"type": "boolean", "optional": true},
    "brand":      {"type": "brand_kit"}
  },
  "outputs": {
    "feed":   {"kind": "still", "width": 1080, "height": 1350, "composition": "layer-still-v1--feed", "format": "4:5"},
    "square": {"kind": "still", "width": 1080, "height": 1080, "composition": "layer-still-v1--square", "format": "1:1"},
    "story":  {"kind": "still", "width": 1080, "height": 1920, "composition": "layer-still-v1--story", "format": "9:16"}
  },
  "cost_model": {"seconds_per_still": 3.0},
  "layer_catalog": {
    "layout_version": 1,
    "source": "docs/catalogo-disenos-imagen-carrusel.md (approved 2026-11-14); limits are [H] until m-25017292 measures them",
    "formats": {
      "4:5":  {"width": 1080, "height": 1350, "margin": 64, "safe": [64, 64, 1016, 1286], "title_zone_x": [64, 1016]},
      "1:1":  {"width": 1080, "height": 1080, "margin": 64, "safe": [64, 64, 1016, 1016], "title_zone_x": [135, 945]},
      "9:16": {"width": 1080, "height": 1920, "margin": 64, "safe": [64, 270, 1016, 1536], "title_zone_x": [64, 1016]}
    },
    "font_sizes": {
      "title":            {"4:5": [104, 72], "1:1": [96, 72], "9:16": [112, 76]},
      "title_brand_fill": {"4:5": [120, 80], "1:1": [112, 76], "9:16": [128, 84]},
      "subtitle":         {"4:5": [52, 40], "1:1": [48, 40], "9:16": [56, 44]},
      "call_phrase":      {"4:5": [44, 40], "1:1": [44, 40], "9:16": [48, 44]},
      "info_label":       {"4:5": [34, 32], "1:1": [34, 32], "9:16": [36, 34]},
      "info_value":       {"4:5": [46, 40], "1:1": [44, 40], "9:16": [50, 44]},
      "info_value_single":{"4:5": [72, 56], "1:1": [68, 52], "9:16": [80, 60]},
      "highlight_word":   {"9:16": [140, 96]},
      "counter":          {"4:5": [32, 32], "1:1": [32, 32]}
