{
  "name": "@qualify/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Qualify render service: Remotion compositions + HTTP server (see CONTRACT.md).",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "remotion bundle src/index.ts --out-dir build",
    "serve": "node server.mjs",
    "render:cli": "node scripts/render-cli.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
