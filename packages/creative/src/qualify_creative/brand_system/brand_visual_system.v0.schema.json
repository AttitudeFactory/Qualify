                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "on_accent",
          "title": "Ink"
        },
        "show_code": {
          "default": true,
          "description": "Print the currency code (COP, USD) small.",
          "title": "Show Code",
          "type": "boolean"
        }
      },
      "title": "PriceSpec",
      "type": "object"
    },
    "ProductFrameSpec": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "default": "cutout_glow",
          "enum": [
            "cutout_glow",
            "cutout_sun",
            "disc",
            "arch",
            "rounded",
            "blob"
          ],
          "title": "Variant",
