            }
          ],
          "default": "surface",
          "title": "Badge"
        }
      },
      "title": "LogoSpec",
      "type": "object"
    },
    "PriceSpec": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "default": "flag",
          "enum": [
            "flag",
            "badge",
            "circle",
            "ticket",
            "plain"
          ],
          "title": "Variant",
          "type": "string"
        },
        "fill": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "accent",
          "title": "Fill"
