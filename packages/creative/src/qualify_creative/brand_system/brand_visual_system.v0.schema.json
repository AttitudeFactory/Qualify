{
  "$defs": {
    "Background": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "default": "radial",
          "enum": [
            "solid",
            "radial",
            "linear"
          ],
          "title": "Base",
          "type": "string"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/BackgroundLayer"
          },
          "maxItems": 4,
          "title": "Layers",
          "type": "array"
        }
      },
      "title": "Background",
      "type": "object"
    },
    "BackgroundLayer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rays",
            "rings",
            "dots",
            "stripes",
            "grid",
            "waves",
            "pattern_image",
            "blobs",
            "grain",
            "confetti"
          ],
          "title": "Kind",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "pop",
          "title": "Color"
        },
        "opacity": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "description": "Size multiplier of the motif.",
          "maximum": 5.0,
          "minimum": 0.2,
          "title": "Scale",
          "type": "number"
        },
        "angle_deg": {
          "default": 0.0,
          "maximum": 180,
          "minimum": -180,
          "title": "Angle Deg",
          "type": "number"
        },
        "center": {
          "default": [
            0.5,
            0.42
          ],
          "description": "rays/rings/blobs centre, canvas fractions.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pattern_image only: a brand asset path.",
          "title": "Image"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BackgroundLayer",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "photo",
            "logo",
            "product",
            "stamp",
            "text_stack",
            "ticker",
            "info_list",
            "icon_feature",
            "sparkle",
            "glow",
            "sun"
          ],
          "title": "Type",
          "type": "string"
        },
        "box": {
          "description": "x, y, w, h in canvas fractions; may bleed outside [0,1].",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "align": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "valign": {
          "default": "top",
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Valign",
          "type": "string"
        },
        "rotate_deg": {
          "default": 0.0,
          "maximum": 30,
          "minimum": -30,
          "title": "Rotate Deg",
          "type": "number"
        },
        "z": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Z",
          "type": "integer"
        },
        "slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/StackItem"
          },
          "maxItems": 8,
          "title": "Items",
          "type": "array"
        },
        "icon": {
          "anyOf": [
            {
              "enum": [
                "clock",
                "pin",
                "card",
                "chat",
                "bag",
                "star",
                "heart"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "fade": {
          "default": "none",
          "description": "photo: veil.",
          "enum": [
            "none",
            "bottom",
            "full"
          ],
          "title": "Fade",
          "type": "string"
        },
        "mirror": {
          "default": false,
          "title": "Mirror",
          "type": "boolean"
        },
        "focus": {
          "default": [
            0.5,
            0.5
          ],
          "description": "photo: focal point.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Focus",
          "type": "array"
        },
        "zoom": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "photo: image height / box height (None = cover).",
          "title": "Zoom"
        },
        "veil": {
          "description": "photo: gradient over the whole canvas.",
          "items": {
            "$ref": "#/$defs/VeilStop"
          },
          "maxItems": 8,
          "title": "Veil",
          "type": "array"
        },
        "saturate": {
          "default": 1.0,
          "maximum": 1.6,
          "minimum": 0.5,
          "title": "Saturate",
          "type": "number"
        },
        "contrast": {
          "default": 1.0,
          "maximum": 1.6,
          "minimum": 0.5,
          "title": "Contrast",
          "type": "number"
        },
        "framed": {
          "default": false,
          "description": "photo: card with border, radius and tilt.",
          "title": "Framed",
          "type": "boolean"
        },
        "colors": {
          "description": "glow/sun/sparkle: colour overrides.",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "background",
                  "background_alt",
                  "surface",
                  "on_surface",
                  "ink",
                  "accent",
                  "on_accent",
                  "shadow",
                  "pop"
                ],
                "type": "string"
              },
              {
                "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
                "type": "string"
              }
            ]
          },
          "maxItems": 3,
          "title": "Colors",
          "type": "array"
        }
      },
      "required": [
        "type",
        "box"
      ],
      "title": "Block",
      "type": "object"
    },
    "BodySpec": {
      "additionalProperties": false,
      "properties": {
        "strong_color": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "accent",
          "title": "Strong Color"
        },
        "strong_uppercase": {
          "default": true,
          "title": "Strong Uppercase",
          "type": "boolean"
        },
        "chip_fill": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "surface",
          "title": "Chip Fill"
        },
        "chip_ink": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "background",
          "title": "Chip Ink"
        }
      },
      "title": "BodySpec",
      "type": "object"
    },
    "CardSpec": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "default": "card",
          "enum": [
            "card",
            "chip",
            "outline",
            "plain"
          ],
          "title": "Variant",
          "type": "string"
        },
        "fill": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "surface",
          "title": "Fill"
        },
        "ink": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "on_surface",
          "title": "Ink"
        }
      },
      "title": "CardSpec",
      "type": "object"
    },
    "Colors": {
      "additionalProperties": false,
      "description": "Colour ROLES, not a palette: every component paints with a role.",
      "properties": {
        "background": {
          "description": "Main canvas colour.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "background_alt": {
          "description": "Second background tone (glow centre, gradient end).",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background Alt",
          "type": "string"
        },
        "surface": {
          "description": "Cards, stamps, chips.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Surface",
          "type": "string"
        },
        "on_surface": {
          "description": "Text on surface.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "On Surface",
          "type": "string"
        },
        "ink": {
          "description": "Text directly on the background.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Ink",
          "type": "string"
        },
        "accent": {
          "description": "Highlight: second headline line, price flag, tag.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "on_accent": {
          "description": "Text on accent.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "On Accent",
          "type": "string"
        },
        "shadow": {
          "description": "Hard/soft shadow colour.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Shadow",
          "type": "string"
        },
        "pop": {
          "description": "Secondary colour for decorations (rays, dots, sun).",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Pop",
          "type": "string"
        },
        "background_edge": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Third stop of a radial base.",
          "title": "Background Edge"
        },
        "shadow_deep": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Blurred shadows (defaults to shadow).",
          "title": "Shadow Deep"
        }
      },
      "required": [
        "background",
        "background_alt",
        "surface",
        "on_surface",
        "ink",
        "accent",
        "on_accent",
        "shadow",
        "pop"
      ],
      "title": "Colors",
      "type": "object"
    },
    "Components": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/BodySpec"
        },
        "tag": {
          "$ref": "#/$defs/TagSpec"
        },
        "headline": {
          "$ref": "#/$defs/HeadlineSpec"
        },
        "price": {
          "$ref": "#/$defs/PriceSpec"
        },
        "stamp": {
          "$ref": "#/$defs/StampSpec"
        },
        "ticker": {
          "$ref": "#/$defs/TickerSpec"
        },
        "product_frame": {
          "$ref": "#/$defs/ProductFrameSpec"
        },
        "info_card": {
          "$ref": "#/$defs/CardSpec"
        },
        "logo": {
          "$ref": "#/$defs/LogoSpec"
        },
        "sparkle": {
          "$ref": "#/$defs/SparkleSpec"
        }
      },
      "title": "Components",
      "type": "object"
    },
    "HeadlineSpec": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "default": "two_tone_stacked",
          "enum": [
            "two_tone_stacked",
            "single_color",
            "outline_second",
            "highlight_second"
          ],
          "title": "Variant",
          "type": "string"
        },
        "split": {
          "default": "first_word",
          "description": "first_word: «Shawarma|mixto»; last_word: «¡Abrimos|hoy!»; none: one group.",
          "enum": [
            "first_word",
            "last_word",
            "none"
          ],
          "title": "Split",
          "type": "string"
        },
        "first_color": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "ink",
          "title": "First Color"
        },
        "second_color": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "accent",
          "title": "Second Color"
        },
        "shadow": {
          "default": true,
          "title": "Shadow",
          "type": "boolean"
        }
      },
      "title": "HeadlineSpec",
      "type": "object"
    },
    "LogoSpec": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "default": "plain",
          "enum": [
            "plain",
            "on_badge"
          ],
          "title": "Variant",
          "type": "string"
        },
        "badge": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
