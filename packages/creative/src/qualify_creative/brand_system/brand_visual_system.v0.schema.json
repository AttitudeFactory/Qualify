    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "transcribed",
            "ai_proposal",
            "owner_edit"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "created_at": {
          "description": "ISO 8601.",
          "title": "Created At",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "4:5",
            "1:1",
            "9:16"
          ],
          "title": "Format",
          "type": "string"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Background"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the system one."
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "maxItems": 14,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "format",
        "blocks"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "Shapes": {
      "additionalProperties": false,
      "properties": {
        "radius_px": {
          "default": 24,
          "description": "Corner radius at 1080 px wide.",
          "maximum": 80,
          "minimum": 0,
          "title": "Radius Px",
          "type": "integer"
        },
        "tilt_deg": {
          "default": 0.0,
          "description": "Default tilt of tags/flags/cards.",
          "maximum": 8,
          "minimum": -8,
          "title": "Tilt Deg",
          "type": "number"
        },
        "shadow": {
          "default": "hard",
          "enum": [
