                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          ],
          "default": "surface",
          "title": "Ring"
        },
        "glow": {
          "anyOf": [
            {
              "enum": [
                "background",
                "background_alt",
                "surface",
                "on_surface",
                "ink",
                "accent",
                "on_accent",
                "shadow",
                "pop"
              ],
              "type": "string"
            },
            {
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
