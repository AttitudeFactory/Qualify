# Qualify — variables de entorno de la app (copia a `.env`; `.env` está en .gitignore).
# Reflex carga `.env` por `rxconfig.py` (env_file=".env"); los scripts CLI usan python-dotenv.
# Nunca pongas valores reales aquí: este archivo SÍ se versiona. Los secretos de CI viven en
# GitHub (CLAUDE_CODE_OAUTH_TOKEN, SONAR_TOKEN), no en este archivo.

# --- Base de datos (compose local: `just up`; los roles los crea la migración 0001/0002) ---
# Sin estos cuatro, el código usa los DSN de desarrollo contra localhost:5432/qualify.
QUALIFY_MIGRATION_DSN=postgresql+psycopg://qualify_owner:dev_only@localhost:5432/qualify
QUALIFY_APP_DSN=postgresql+psycopg://qualify_app:app_dev@localhost:5432/qualify
QUALIFY_ADMIN_DSN=postgresql+psycopg://qualify_admin:admin_dev@localhost:5432/qualify
QUALIFY_CREDENTIAL_DSN=postgresql+psycopg://qualify_credential:credential_dev@localhost:5432/qualify
# Webhook de Meta (QUA-147, migración 0050). Sin estas dos, el código usa estos mismos valores.
QUALIFY_WEBHOOK_DSN=postgresql+psycopg://qualify_webhook:webhook_dev@localhost:5432/qualify
QUALIFY_WEBHOOK_WORKER_DSN=postgresql+psycopg://qualify_webhook_worker:webhook_worker_dev@localhost:5432/qualify
QUALIFY_CREATIVE_WORKER_DSN=postgresql+psycopg://qualify_creative_worker:creative_worker_dev@localhost:5432/qualify
# Borrado explícito de conexiones IG/FB (m-24789547). Rol separado sujeto a RLS.
QUALIFY_CONNECTION_PURGE_DSN=postgresql+psycopg://qualify_connection_purge:connection_purge_dev@localhost:5432/qualify
# Producción: sin esta clave el bootstrap mantiene el rol NOLOGIN. Requiere aprobación.
# Producción: env-stage de esta contraseña hex y deploy; Compose arma el DSN.
# connection-purge-worker arranca siempre y queda inactivo mientras falte.
# QUALIFY_DB_CONNECTION_PURGE_PASSWORD=
# Sentimiento con el modelo local (robertuito, torch, grupo `ml`; m-24854340): APAGADO por
# defecto, en el webhook-worker y en el análisis tras sincronizar de Interacciones. Encendido
# (1/true/yes/on) carga ~904 MiB. La intención comercial (Claude) corre igual.
# QUALIFY_SENTIMENT_ENABLED=
QUALIFY_REDIS_URL=redis://localhost:6379/0

# --- Autenticación de la app (Supabase) ---
QUALIFY_SUPABASE_URL=
QUALIFY_SUPABASE_PUBLISHABLE_KEY=
QUALIFY_SUPABASE_SECRET_KEY=
# Solo desarrollo/tests: auth falsa en memoria. NUNCA en staging/producción.
# QUALIFY_AUTH_FAKE=1
# QUALIFY_AUTH_FAKE_STATE_PATH=
# Registro sin invitación, solo desarrollo/tests. NUNCA en producción (el compose lo vacía).
# QUALIFY_SIGNUP_OPEN=1
# Tenant de la casa: recibe en /leads a quien pide invitación sin código (MARCA-5).
# QUALIFY_INTEREST_TENANT_ID=

# --- Correo transaccional (Resend): invitaciones ---
QUALIFY_RESEND_API_KEY=
QUALIFY_MAIL_FROM=Herwin de Qualify <no-reply@send.qualify.la>
QUALIFY_INVITE_SIGNER=Herwin Rey
QUALIFY_MAIL_REPLY_TO=
# Solo desarrollo: registra el correo en el log en vez de enviarlo.
# QUALIFY_MAIL_FAKE=1
# Secreto de firma (Svix, `whsec_…`) del webhook de Resend que llega a /api/mail/resend
# (entregado / abierto / rebotó → signup_invites y el ítem de Meegle; plan M2). Sin valor,
# el endpoint responde 503 y NUNCA acepta eventos sin firmar.
QUALIFY_RESEND_WEBHOOK_SECRET=

# --- Altas de clientes desde Meegle (docs/plan-altas-meegle.md, fase M1) ---
# Sin las seis siguientes el motor queda APAGADO (los eventos de Meegle se guardan en la
# bandeja de webhooks como `unsupported` y `just invite` sigue funcionando igual).
# QUALIFY_MEEGLE_BASE_URL=https://meegle.com
QUALIFY_MEEGLE_PLUGIN_ID=
QUALIFY_MEEGLE_PLUGIN_SECRET=
# Token del Event Listener del plugin (firma de los eventos que llegan a /api/meegle/events).
QUALIFY_MEEGLE_CALLBACK_TOKEN=
# Espacio «Qualify» y tipo de ítem «Alta de cliente».
QUALIFY_MEEGLE_PROJECT_KEY=
QUALIFY_MEEGLE_WORK_ITEM_TYPE=
# Miembro del espacio a cuyo nombre escribe Qualify (X-User-Key; decisión D1 del plan).
QUALIFY_MEEGLE_USER_KEY=
# Nombres de campos/nodos si el ítem se creó con otras etiquetas (por defecto los del plan §2):
# QUALIFY_MEEGLE_FIELD_EMAIL=Correo  QUALIFY_MEEGLE_FIELD_STATUS=Estado Qualify  QUALIFY_MEEGLE_NODE_DATA=Datos
# QUALIFY_MEEGLE_FIELD_INSTAGRAM=Cuenta de Instagram   (opcional: sin el campo, la invitación sale igual)
# QUALIFY_MEEGLE_FIELD_EXISTING_LOGIN=Inicio de sesión existente  (opcional: Sí agrega un negocio a una cuenta)
# Precarga de la identidad de marca desde el Alta (PB-4, m-24852198): APAGADA por defecto.
# Encendida, al completar «Datos» con «Cuenta de Instagram» el webhook-worker prepara el
# borrador reservado y lee la cuenta (ScrapeCreators + Claude: cuesta dinero). Sin tope
# válido no corre. No pongas valor aquí: el fundador fija el tope tras medir (PB-6).
# QUALIFY_ALTA_PREFILL_ENABLED=
# QUALIFY_ALTA_PREFILL_MAX_USD=
# Avisos de tickets (Features/Issues/Tasks del espacio) al grupo de Lark (plan §3bis). Webhook
# de un bot personalizado del grupo; sin él los eventos de esos tipos quedan `unsupported`.
# QUALIFY_MEEGLE_NOTIFY_WEBHOOK_URL=
# QUALIFY_MEEGLE_TICKET_TYPES=story,issue,sub_task
# QUALIFY_MEEGLE_WEB_URL=https://project.larksuite.com
# QUALIFY_DEV_PRINCIPALS=

# --- Meta (Facebook Login for Business, publicación, inbox) ---
QUALIFY_META_APP_ID=
QUALIFY_META_APP_SECRET=
QUALIFY_META_REDIRECT_URI=http://localhost:8000/api/connections/callback
# Where the OAuth callback sends the browser back (QUA-123): <this>/connections?connect=<code>.
# Defaults to REFLEX_DEPLOY_URL, then http://localhost:3000.
# QUALIFY_APP_URL=
QUALIFY_META_SCOPES=
# QUALIFY_META_CONFIG_ID=
# QUALIFY_META_ACCESS_POSTURE=development
# QUALIFY_META_API_VERSION=
# QUALIFY_GRAPH_BASE_URL=
# QUALIFY_META_AUTHORIZE_URL=
# QUALIFY_META_GRAPH_AUTH_SCHEME=Bearer
# QUALIFY_META_RUPLOAD_AUTH_SCHEME=OAuth
# QUALIFY_META_WEBHOOK_VERIFY_TOKEN=
# Token de verificación del webhook de WhatsApp (producto «Whatsapp Business Account»), independiente del de menciones.
# QUALIFY_WA_WEBHOOK_VERIFY_TOKEN=
# QUA-226: qué implementación atiende el canal `dm` de Conversaciones. `instagram` (por
# defecto y único valor de producción) o `memory` (SOLO desarrollo: el par en memoria, para
# validar /conversations en localhost sin Meta; `just conversations-seed` lo rellena).
# QUALIFY_CONVERSATIONS_DM_CHANNEL=instagram
# m-24789644: capacidad `story_comments` — `on` ofrece las historias (GET /{ig-user-id}/stories)
# para monitorear sus comentarios en Interacciones. DEJARLA APAGADA: R1 (2026-10-21) comprobó
# que Meta rechaza `GET /{story-id}/comments` («Comments cannot be made on story media»).
# Antes de encenderla, repetir `just story-probe` (docs/conversaciones-limitaciones-meta.md §6).
# QUALIFY_STORY_COMMENTS=off
# m-24789646 (Fase C): capacidades por origen para continuar en privado una consulta.
# Apagadas por defecto; solo `on` las enciende, y una no implementada sigue apagada
# (estado de cada una: docs/conversaciones-limitaciones-meta.md §7).
# `comment_private_reply`: verificada con Meta (R1, 2026-10-22, §7).
# QUALIFY_COMMENT_PRIVATE_REPLY=off
# `story_reply_context`: verificada (R3, 2026-10-22, §7). Con `on` la sincronización pide a Meta
# a qué historia responde cada DM y esas respuestas se clasifican y se abren como consultas.
# QUALIFY_STORY_REPLY_CONTEXT=off
# `public_notice`: verificada (R4, 2026-10-22, §7). Hace falta en la app (la casilla del aviso)
# Y en el conversations-worker (quien lo publica).
# Fase C necesita en QUALIFY_META_SCOPES: instagram_manage_messages, pages_messaging y
# pages_manage_metadata, y la Página de cada cuenta suscrita a la app (§7, QUA-129).
# QUALIFY_PUBLIC_NOTICE=off
QUALIFY_OAUTH_STATE_SECRET=
# QUALIFY_OAUTH_STATE_TTL=600

# --- Custodia de credenciales (cifrado de sobre) ---
# En desarrollo hay una llave por defecto en el código; en cualquier entorno real DEBE fijarse.
# QUALIFY_DEV_FERNET_KEY=
# QUALIFY_DEV_KEY_ID=dev-1

# --- Observabilidad de pruebas de modelos (Langfuse) ---
# Desde el 2026-10-24 (ADR 40): Langfuse Cloud EU, proyecto qualify-dev; las claves las da el
# fundador por un canal privado y LANGFUSE_BASE_URL=https://cloud.langfuse.com.
# Sin LANGFUSE_BASE_URL el SDK también usa https://cloud.langfuse.com (su valor por defecto).
# Langfuse local opcional (`just langfuse-up`): claves LANGFUSE_INIT_PROJECT_PUBLIC_KEY /
# _SECRET_KEY de infra/langfuse/.env y LANGFUSE_BASE_URL=http://localhost:3100.
# Vacías = la app no envía trazas (docs/plan-observabilidad-langfuse.md §5).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development

# --- Generación de contenido (Motor de Contenido de Marca) ---
QUALIFY_ANTHROPIC_API_KEY=
# [RETIRADO 2026-10-16] HeyGen ya no se usa en el código: el presentador que habla es
# OmniHuman y la voz (incluida la clonada del Brand Kit) es Seed Speech, abajo.
# Presentador que habla (§ 2026-10-16, docs/pendientes-generador-contenido.md §6):
# Seedream compone al presentador, Seed Speech lee el guion con la voz elegida y OmniHuman
# lo hace hablar. Son DOS llaves de BytePlus distintas a la de ModelArk:
# - Seed Speech (consola BytePlus Voice → API Key): voces públicas + clon de voz de la marca.
QUALIFY_BYTEPLUS_SPEECH_API_KEY=
# - Vision AI / OmniHuman (consola BytePlus Vision AI → API Key, va como Bearer).
QUALIFY_BYTEPLUS_CV_API_KEY=
# Versión de OmniHuman: realman_avatar_picture_omni15_cv (1.5, por defecto, audio < 60 s,
# 720p o 1080p) o realman_avatar_picture_omni20_cv (2.0, 720p).
QUALIFY_OMNIHUMAN_REQ_KEY=
QUALIFY_OMNIHUMAN_RESOLUTION=720
# BytePlus ModelArk (§ 2026-10-07): Seedream genera la escena de la imagen publicitaria y
# el primer fotograma de los videos; Seedance anima el video. Una sola llave para ambos.
QUALIFY_BYTEPLUS_ARK_API_KEY=
QUALIFY_BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Evaluaciones (m-24852161): llave propia de ModelArk para `just eval-*`, distinta de la de
# la app y de la de producción. NO da más cupo: las 10 tareas a la vez de Seedance son por
# cuenta principal, sumando subcuentas. Las evaluaciones con video corren de 23:00 a 05:00
# hora de Bogotá (docs/modelos-generativos/pruebas.md). Solo en .env local, nunca en
# .env.prod. La huella (no la llave) de producción deja que la evaluación se niegue a
# gastar con ella; `just byteplus-llaves` compara las huellas sin imprimir valores.
QUALIFY_BYTEPLUS_ARK_EVAL_API_KEY=
QUALIFY_BYTEPLUS_ARK_PROD_KEY_FINGERPRINT=
# Modelos (vacío = los de prueba: seedance-1-0-pro-250528, video SIN voz, y
# seedream-5-0-lite-260128). Con un Seedance 2.x (p. ej. dreamina-seedance-2-5-260628) el
# avatar dice el guion. Resolución de Seedance: 480p, 720p (por defecto) o 1080p.
# Activo desde 2026-10-23: dreamina-seedance-2-5-260628 en los dos de Seedance (con 2.5
# todo video sale como borrador 480p y el final a 1080p se hace al aprobar). El modelo de
# referencias (clip con imágenes/videos/audios, diapositiva con video de referencia) vacío
# = dreamina-seedance-2-0-mini-260615.
QUALIFY_SEEDANCE_MODEL=
QUALIFY_SEEDANCE_REFERENCE_MODEL=
QUALIFY_SEEDREAM_MODEL=
QUALIFY_SEEDANCE_RESOLUTION=720p
# «Tu avatar animado» del Brand Kit (docs/brand-kit-avatar-animado.md, ESQUEMATIZADO): al
# terminar el Brand Kit, Seedream dibuja una mascota de la marca, que se ve y se regenera en
# /brand/kit. Apagado por defecto; pide además QUALIFY_BYTEPLUS_ARK_API_KEY (arriba).
# Encender (1/true/on) solo tras la verificación en vivo del checklist del documento.
QUALIFY_BRAND_AVATAR=
# Stock de imágenes (docs/plan-integracion-stock-pexels-pixabay.md, 2026-10-16): «Imagen de
# stock» en la pantalla de producto del generador. La clave de Pixabay se ve, con sesión
# iniciada, en https://pixabay.com/api/docs/. Pexels tiene pausada la emisión de claves.
# Sin clave, la pestaña dice «no disponible». Cuotas por tenant y hora (0 apaga la pestaña).
# QUALIFY_STOCK_AI_REFERENCE=off deja el stock fuera de Seedream/Seedance (pregunta F1).
QUALIFY_PIXABAY_API_KEY=
QUALIFY_PEXELS_API_KEY=
QUALIFY_STOCK_SEARCHES_PER_TENANT_HOUR=30
QUALIFY_STOCK_IMPORTS_PER_TENANT_HOUR=20
QUALIFY_STOCK_AI_REFERENCE=on
# Motor de los videos con avatar en el generador: omnihuman o seedance. Vacío = omnihuman
# en cuanto estén las dos llaves de arriba (Seed Speech + Vision AI), seedance mientras
# tanto. Un `heygen` viejo se trata como vacío.
QUALIFY_VIDEO_ENGINE=
# Servicio de render Remotion (packages/render; `just up` lo levanta en compose).
# Leído en qualify_api.creative.composition (RENDER_URL_ENV).
QUALIFY_RENDER_URL=http://localhost:3200
# Carpeta de manifiestos publicados; por defecto packages/render/templates
# QUALIFY_RENDER_TEMPLATES_DIR=
# Hugging Face (transcripción de voz del brand kit, whisper-large-v3-turbo)
HF_TOKEN=
# QUALIFY_WHISPER_MODEL=

# --- Canva (ida y vuelta de última milla) ---
QUALIFY_CANVA_CLIENT_ID=
QUALIFY_CANVA_CLIENT_SECRET=
QUALIFY_CANVA_REDIRECT_URI=

# --- Almacenamiento de objetos (Cloudflare R2) ---
QUALIFY_R2_ENDPOINT_URL=
QUALIFY_R2_ACCESS_KEY_ID=
QUALIFY_R2_SECRET_ACCESS_KEY=
QUALIFY_R2_BUCKET=
# URL pública desde la que los proveedores descargan foto, voz y los videos/audios de
# referencia de Seedance (OmniHuman y ModelArk no aceptan Base64 para ellos). Debe apuntar
# al servidor de qualify_api (la ruta /public/media/{token} vive ahí, NO en Reflex :3000).
# En local `localhost` NO sirve: levanta la API y un túnel hacia ella:
#   uvicorn --factory qualify_api.http.app:create_app --host 127.0.0.1 --port 8010 --env-file .env
#   cloudflared tunnel --url http://127.0.0.1:8010
# (en Git Bash, antepón MSYS_NO_PATHCONV=1 o la URL se estropea). La URL de un túnel rápido
# cambia en cada arranque y caduca: actualízala aquí y reinicia Reflex.
# QUALIFY_PUBLIC_MEDIA_BASE_URL=
# Carpeta local de subidas de Reflex (catálogo, generador); por defecto `uploaded_files`
# REFLEX_UPLOADED_FILES_DIR=uploaded_files

# --- Referentes / scraping ---
SCRAPECREATORS_API_KEY=
# Obligatoria para el scraper de Zyte (qualify_scraper.client la lee con os.environ[...]).
ZYTE_API_KEY=
# QUALIFY_AVATAR_DIR=
# QUALIFY_AVATAR_REFRESH_PER_HOUR=

# --- Planificador (QUA-111): el worker arranca embebido y PUBLICA DE VERDAD ---
# `embedded` (por defecto) | `off`. En staging: off, o restringido a tenants propios.
# QUALIFY_CALENDAR_WORKER=embedded
# QUALIFY_CALENDAR_WORKER_TENANTS=all
# QUALIFY_CALENDAR_WORKER_INTERVAL=60
# m-24852492: al lado de los ticks recupera los videos de BytePlus terminados sin pantalla.
# QUALIFY_VENDOR_RECOVERY=on

# --- Semilla ---
# QUALIFY_SEED_AGENTS=

# --- Solo tests / evals ---
# QUALIFY_RUN_SCALE_BENCHMARK=1

# QUA-202 — «Pedir ayuda 1:1» en /connections. Webhook entrante del canal global de
# soporte/ventas (Lark, Slack o Cliq: el payload lleva `text` y `msg_type`+`content`).
# Sin él, el ticket se guarda igual en `support_requests` y se avisa en log.
# QUALIFY_SUPPORT_WEBHOOK_URL=
# El mismo canal recibe avisos de cola y planes. En Lark/Feishu, opcional si el bot
# exige verificación de firma; no usar el secreto de otro bot. Sin firma, la seguridad
# por palabras clave/IP del bot debe aceptar estos avisos (no contienen «Deploy»).
# QUALIFY_SUPPORT_WEBHOOK_SECRET=

# Set 0 to stop retention warning emails without disabling the daily file purge.
# QUALIFY_PIECE_WARNING_EMAILS=1

# Optional Alta-only sourced answers; keep off until B1 quality evaluation (m-24854330).
QUALIFY_ALTA_PREFILL_DRAFTS_ENABLED=0
